{
  "name": "recap-test-hana",
  "version": "1.0.0",
  "description": "Testing CAP applications against SAP HANA Cloud with vitest — reCAP demo",
  "private": true,
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap/cds": "^10",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.1",
    "@cap-js/cds-typer": ">=0.4",
    "@cap-js/cds-types": "^0.18.0",
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "build": "cds build --production",
    "init:test-setup": "npm add -D @cap-js/cds-test @vitest/coverage-v8 @vitest/ui vitest",
    "test:sqlite": "NODE_ENV=development CDS_TYPESCRIPT=true cds_requires_db_credentials_url=:memory: vitest --coverage --ui --open=false",
    "test:hana": "CDS_TYPESCRIPT=true cds bind --exec --profile hana vitest -- --coverage",
    "deploy:hana": "cds deploy --to hana:recap-test-hana-db --for hana --auto-undeploy",
    "repl:hana": "cds bind --exec --profile hana cds repl -- --run ."
  },
  "cds": {
    "requires": {
      "[development]": {
        "db": "sql"
      },
      "[hana]": {
        "db": "hana",
        "auth": {
          "kind": "dummy"
        }
      },
      "[production]": {
        "db": "hana",
        "auth": "xsuaa"
      }
    },
    "hana": {
      "deploy-format": "hdbtable"
    }
  }
}
